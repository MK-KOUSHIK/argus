# Argus Backend Environment Configuration
APP_NAME=Argus
ENVIRONMENT=development
DEBUG=True
API_PREFIX=/api
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Local Ollama Inference (Phase 3 & 3.1)
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:1.5b
OLLAMA_TIMEOUT_SECONDS=60.0
OLLAMA_STATUS_TIMEOUT_SECONDS=4.0

# Ollama KV cache/server configuration (apply to the Ollama server process, not FastAPI)
# Set OLLAMA_FLASH_ATTENTION=1 and OLLAMA_KV_CACHE_TYPE=q8_0 in the Ollama
# server environment, then restart Ollama. Argus reports these as desired policy;
# it cannot verify an already-running server's environment through /api/generate.
OLLAMA_FLASH_ATTENTION=True
OLLAMA_KV_CACHE_TYPE=q8_0

# Per-request generation/context policy enforced by Argus
OLLAMA_NUM_CTX=4096
OLLAMA_MAX_NUM_CTX=8192
OLLAMA_NUM_PREDICT=512
OLLAMA_CONTEXT_RESERVE_TOKENS=256
OLLAMA_MAX_CONCURRENT_REQUESTS=1

# Model Generation Hyperparameters
OLLAMA_TEMPERATURE=0.2
OLLAMA_TOP_P=0.9

# Heuristic & Optimization Limits
CHARS_PER_TOKEN_HEURISTIC=4.0
MAX_VALIDATION_RETRY_ATTEMPTS=1

# Main LLM Provider Integration (Phase 4 - Google Gemini as Default)
MAIN_LLM_PROVIDER=gemini
# Google Gemini API key from Google AI Studio (https://aistudio.google.com/):
GEMINI_API_KEY=
GEMINI_API_BASE=https://generativelanguage.googleapis.com/v1beta
MAIN_LLM_MODEL=gemini-1.5-flash
MAIN_LLM_TIMEOUT_SECONDS=60.0
MAIN_LLM_TEMPERATURE=0.2
MAIN_LLM_MAX_TOKENS=1500

# Optional / Alternative: OpenAI Provider
# OPENAI_API_KEY=
# OPENAI_API_BASE=https://api.openai.com/v1
