# Argus Backend Environment Configuration
APP_NAME=Argus
ENVIRONMENT=development
DEBUG=True
API_PREFIX=/api
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Local Ollama Inference (Phase 3 & 3.1)
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:1.5b
OLLAMA_TIMEOUT_SECONDS=60.0
OLLAMA_STATUS_TIMEOUT_SECONDS=4.0

# Ollama KV cache/server configuration (apply to the Ollama server process, not FastAPI)
# Set OLLAMA_FLASH_ATTENTION=1 and OLLAMA_KV_CACHE_TYPE=q8_0 in the Ollama
# server environment, then restart Ollama. Argus reports these as desired policy;
# it cannot verify an already-running server's environment through /api/generate.
OLLAMA_FLASH_ATTENTION=True
OLLAMA_KV_CACHE_TYPE=q8_0

# Per-request generation/context policy enforced by Argus
OLLAMA_NUM_CTX=4096
OLLAMA_MAX_NUM_CTX=8192
OLLAMA_NUM_PREDICT=512
OLLAMA_CONTEXT_RESERVE_TOKENS=256
OLLAMA_MAX_CONCURRENT_REQUESTS=1

# Output Budget Control (Phase 4.1)
OUTPUT_BUDGET_ENABLED=True
# Allocation policy:
#   adaptive     - Dynamically determines ceilings based on task category baselines, mode scaling, complexity, and explicit length directives
#   fixed        - Enforces static OUTPUT_BUDGET_DEFAULT_TOKENS ceiling across all requests
#   conservative - KV-cache-preserving policy: applies dampened baselines (0.75x), zero padding on explicit constraints, and caps at default tokens
OUTPUT_BUDGET_POLICY=adaptive
OUTPUT_BUDGET_MIN_TOKENS=64
OUTPUT_BUDGET_MAX_TOKENS=2048
OUTPUT_BUDGET_DEFAULT_TOKENS=512
OUTPUT_BUDGET_SAFETY_HEADROOM=64

# Configurable baseline generation token budgets per supported task category (JSON string or dict)
# Every supported category must be declared: coding, data_analysis, writing, summarization, research, extraction, planning, general
OUTPUT_BUDGET_TASK_BASELINES={"summarization":256,"extraction":256,"data_analysis":384,"coding":512,"planning":512,"writing":512,"research":512,"general":384}

# Optimization mode multipliers (concise, balanced, structure)
OUTPUT_BUDGET_MODE_SCALING={"concise":0.75,"balanced":1.0,"structure":1.2}

# Independent Content-Aware Compression Engine (Phase 4.2)
COMPRESSION_ENABLED=True
COMPRESSION_REVERSIBLE=True
COMPRESSION_TTL_SECONDS=3600
COMPRESSION_REGISTRY_MAX_ENTRIES=1000
COMPRESSION_MIN_CHARS_THRESHOLD=40
COMPRESSION_STRATEGIES_ENABLED={"json":true,"code":true,"logs":true,"text":true}

# Local-First Model Routing (Phase 5)
ROUTING_ENABLED=True
ROUTING_POLICY=auto
ROUTING_COMPLEXITY_THRESHOLD=0.55
ROUTING_DEFAULT_FALLBACK_MODEL=qwen2.5:1.5b
ROUTING_VRAM_SAFETY_MARGIN_MB=512
ROUTING_RAM_SAFETY_MARGIN_MB=1024
ROUTING_LOADED_HEADROOM_MARGIN_MB=250
ROUTING_REGISTRY_TTL_SECONDS=5.0
ROUTING_ALLOW_UNKNOWN_TIER=False
ROUTING_ALLOW_OVERRIDE_FALLBACK=False
ROUTING_ALLOW_CPU_EXECUTION=True
ROUTING_REQUIRE_ARCHITECTURE_METADATA=False

# CPU Runtime Memory Allowances in MiB (Phase 5)
# Non-negative integers configured independently per tier to cover CPU runtime scratchpad,
# execution activations, and buffer headroom during CPU-only inference.
ROUTING_CPU_ALLOWANCE_DEFAULT_MB=128
ROUTING_CPU_ALLOWANCE_SMALL_MB=64
ROUTING_CPU_ALLOWANCE_MEDIUM_MB=128
ROUTING_CPU_ALLOWANCE_LARGE_MB=256

# Model Generation Hyperparameters
OLLAMA_TEMPERATURE=0.2
OLLAMA_TOP_P=0.9

# Heuristic & Optimization Limits
CHARS_PER_TOKEN_HEURISTIC=4.0
MAX_VALIDATION_RETRY_ATTEMPTS=1

# Main LLM Provider Integration (Phase 4 - Google Gemini as Default)
MAIN_LLM_PROVIDER=gemini
# Google Gemini API key from Google AI Studio (https://aistudio.google.com/):
GEMINI_API_KEY=
GEMINI_API_BASE=https://generativelanguage.googleapis.com/v1beta
MAIN_LLM_MODEL=gemini-1.5-flash
MAIN_LLM_TIMEOUT_SECONDS=60.0
MAIN_LLM_TEMPERATURE=0.2
MAIN_LLM_MAX_TOKENS=1500

# Optional / Alternative: OpenAI Provider
# OPENAI_API_KEY=
# OPENAI_API_BASE=https://api.openai.com/v1
