# Argus Backend Environment Configuration
APP_NAME=Argus
ENVIRONMENT=development
DEBUG=True
API_PREFIX=/api
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Local Ollama Inference (Phase 3 & 3.1)
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:1.5b
OLLAMA_TIMEOUT_SECONDS=60.0
OLLAMA_STATUS_TIMEOUT_SECONDS=4.0

# Model Generation Hyperparameters
OLLAMA_TEMPERATURE=0.2
OLLAMA_TOP_P=0.9

# Heuristic & Optimization Limits
CHARS_PER_TOKEN_HEURISTIC=4.0
MAX_VALIDATION_RETRY_ATTEMPTS=1

# Main LLM Provider Integration (Phase 4)
MAIN_LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_API_BASE=https://api.openai.com/v1
MAIN_LLM_MODEL=gpt-4o
MAIN_LLM_TIMEOUT_SECONDS=60.0
MAIN_LLM_TEMPERATURE=0.2
MAIN_LLM_MAX_TOKENS=1500

# Benchmark Configuration
LIVE_BENCHMARK_ENABLED=False
